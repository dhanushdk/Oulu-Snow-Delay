// DAX measures used in Oulu_Snow_Delay.pbix

AutumnAvgTemp = CALCULATE ( AVERAGE ( oulu_snow_clean[AvgTemp_C] ), oulu_snow_clean[DayOfSeason] >= 31, oulu_snow_clean[DayOfSeason] <= 70 )

Frost Days Autumn = CALCULATE ( SUM ( oulu_snow_clean[IsFrostDay] ), oulu_snow_clean[DayOfSeason] >= 31, oulu_snow_clean[DayOfSeason] <= 70 )

FirstSnowDay = CALCULATE ( MIN ( oulu_snow_clean[DayOfSeason] ), oulu_snow_clean[HasSnow] = 1 )

First Snow Date = CALCULATE ( MIN ( oulu_snow_clean[Date] ), oulu_snow_clean[HasSnow] = 1 )

PermanentSnowDay =
MINX (
    FILTER (
        VALUES ( oulu_snow_clean[DayOfSeason] ),
        VAR d = oulu_snow_clean[DayOfSeason]
        RETURN
            CALCULATE (
                SUM ( oulu_snow_clean[HasSnow] ),
                oulu_snow_clean[DayOfSeason] >= d,
                oulu_snow_clean[DayOfSeason] <= d + 29
            ) = 30
    ),
    oulu_snow_clean[DayOfSeason]
)

Permanent Snow Date =
VAR d = [PermanentSnowDay]
RETURN IF ( ISBLANK ( d ), BLANK (), MIN ( oulu_snow_clean[Date] ) + d - 1 )

Days Without Snow =
VAR snowDay = [First Snow Date]
VAR seasonStart = MIN ( oulu_snow_clean[Date] )
VAR seasonEnd = MAX ( oulu_snow_clean[Date] )
RETURN
    IF (
        ISBLANK ( snowDay ),
        DATEDIFF ( seasonStart, seasonEnd, DAY ) + 1,
        DATEDIFF ( seasonStart, snowDay, DAY )
    )

Snow Status =
VAR snowDay = [First Snow Date]
RETURN
    IF (
        NOT HASONEVALUE ( oulu_snow_clean[Season] ),
        "Select one season",
        IF (
            ISBLANK ( snowDay ),
            "No snow yet – " & [Days Without Snow] & " days without snow",
            "First snow on " & FORMAT ( snowDay, "d MMM yyyy" )
                & " – after " & [Days Without Snow] & " days"
        )
    )

TotalPrecip = SUM ( oulu_snow_clean[Precip_mm] )
FrostDays = SUM ( oulu_snow_clean[IsFrostDay] )
SnowDays = SUM ( oulu_snow_clean[HasSnow] )
